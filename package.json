{
  "name": "spec-autopsy",
  "version": "0.1.0",
  "description": "An autopsy table for AI-built code: checks whether the code matches the specs it was given.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "scripts": {
    "test": "vitest --run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/ui/tsconfig.ui.json",
    "autopsy": "tsx src/cli/autopsy.ts",
    "ui:dev": "vite",
    "ui:build": "vite build",
    "ui:preview": "vite preview",
    "morgue": "tsx src/cli/autopsy.ts . --json src/ui/public/report.json && npm run ui:build"
  },
  "dependencies": {
    "tree-sitter-wasms": "0.1.13",
    "web-tree-sitter": "0.25.10"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "fast-check": "3.23.2",
    "tsx": "4.20.6",
    "typescript": "5.7.2",
    "vite": "5.4.21",
    "vitest": "2.1.8"
  }
}
